{
  "name": "Deck Shelves",
  "navigate": ["/library", "/library/home"],
  "mount_selector": ".ds-card[data-appid]",
  "count_selectors": {
    "shelves":  ".ds-shelf[data-shelfid]",
    "cards":    ".ds-card[data-appid]",
    "featured": ".ds-card--featured"
  },
  "shelf_id_attribute": "data-shelfid",
  "settings_cache_key": "deck-shelves-settings-cache-v3",
  "settings_count_paths": ["shelves", "smartShelves"],
  "thresholds": {
    "mount_ms_warn": 3000,
    "mount_ms_fail": 6000,
    "frame_gap_warn": 50,
    "frame_gap_fail": 100,
    "backnav_full_ms_avg_warn": 1500,
    "backnav_full_ms_avg_fail": 2500,
    "backnav_full_ms_max_fail": 4000,
    "backnav_selection_kept_min_ratio": 0.9,
    "backnav_max_roots": 1,
    "backnav_fallback_mounts_max": 0,
    "backnav_leak_delta_max": 0,
    "backnav_recents_visible_at_end_max": 0,
    "backnav_heap_growth_mb_max": 40,
    "matrix_return_ms_fail": { "typical_8x20": 2500, "stress_16x50": 6000, "large_2000": 7000, "huge_5000": 12000 },
    "matrix_settle_ms_fail": { "typical_8x20": 4000, "stress_16x50": 10000, "large_2000": 10000, "huge_5000": 20000 },
    "matrix_heap_mb_max": 400,
    "soak_ok_ratio_min": 0.98,
    "idle_cpu_delta_pp_fail": 35
  }
}
