# Local dev settings: copy to .env (gitignored) and fill in your values; never put real secrets here.

# Steam Deck SSH connection, used by the deploy and deck:* tasks.
# Hostname or IP of the Deck to deploy to over SSH.
DECK_HOST=192.168.1.x
# SSH username on the Deck.
DECK_USER=deck
# Only used to restart the loader and fix plugin-dir ownership; leave blank and prefer NOPASSWD sudo or SSH keys.
DECK_SUDO_PASS=

# CEF remote debugging. Host defaults to DECK_HOST; use 127.0.0.1 for Steam on this machine.
DECK_CDP_HOST=192.168.1.x
# 8081 for a Deck on the LAN, 8080 for local Steam (localhost-only).
DECK_CDP_PORT=8081

# Only for a Decky install outside ~/homebrew: point at the plugins dir or the homebrew root.
# DECKY_PLUGINS_DIR=/home/deck/homebrew/plugins
# DECKY_HOME=/home/deck/homebrew
